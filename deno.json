{
  "workspace": [
    "./packages/session-storage-kv",
    "./packages/remix-dpop-session-middleware",
    "./web/client",
    "./web/server",
    "./web/tests"
  ],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "serve": "deno task --cwd web/server serve",
    "build": "deno run -A web/server/build.ts && deno bundle --platform browser -o web/dist/worker.js web/server/worker.ts",
    "test": "D1_LOCAL_PATH=:memory: deno test -P --ignore=web/tests",
    "test:browser": "deno task --cwd web/tests test",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno check packages && deno lint && deno fmt --check",
    "db": "deno run -A jsr:@remix-kbn/data-table-d1/cli",
    "wrangler": "deno run -A npm:wrangler",
    "deploy": "deno task build && deno run -A npm:wrangler deploy"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "id.kbn.one",
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@kuboon/dpop": "jsr:@kuboon/dpop@^0.1.2",
    "@kuboon/kv": "jsr:@kuboon/kv@^0.2.0",
    "@lightpanda/browser": "npm:@lightpanda/browser@^1.2.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/data-table-d1": "jsr:@remix-kbn/data-table-d1@^0.1.0",
    "@remix-run/component": "npm:@remix-run/component@^1.0.0",
    "@remix-run/data-table": "npm:@remix-run/data-table@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.0",
    "@remix-run/session": "npm:@remix-run/session@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "jose": "jsr:@panva/jose@^6.2.3",
    "puppeteer-core": "npm:puppeteer-core@^23.11.1"
  },
  "allowScripts": {
    "allow": [
      "npm:@lightpanda/browser@1.2.0"
    ]
  },
  "fmt": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "web/dist",
      "node_modules"
    ]
  }
}
